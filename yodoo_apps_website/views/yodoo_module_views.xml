<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="yodoo_module_form_website">
        <field name="model">yodoo.module</field>
        <field name="inherit_id" ref="yodoo_apps_database.yodoo_module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_published" widget="website_redirect_button"/>
            </xpath>
            <xpath expr="//page[@name='page_external_dependencies']" position="after">
                <page name="page_website" string="Website">
                    <group>
                        <group>
                            <field name="yodoo_apps_website_icon" widget="image"
                                   options="{'size': [128, 128]}"/>
                            <field name="yodoo_apps_website_cover" widget="image"
                                   options="{'size': [400, 225]}"/>
                        </group>
                        <group>
                            <field name="website_url" widget="url"/>
                            <field name="website_meta_title"/>
                            <field name="website_meta_description"/>
                        </group>
                    </group>
                    <field name="yodoo_apps_website_description_html"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
