<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="yodoo_module_category_tree_website">
        <field name="model">yodoo.module.category</field>
        <field name="inherit_id"
               ref="yodoo_apps_database.yodoo_module_category_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='module_count']" position="after">
                <field name="is_published"/>
                <field name="is_listed_on_website"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="yodoo_module_category_form_website">
        <field name="model">yodoo.module.category</field>
        <field name="inherit_id"
               ref="yodoo_apps_database.yodoo_module_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="edit">true</attribute>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="after">
                <group>
                    <field name="is_published"/>
                    <field name="is_listed_on_website"/>
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view"
            id="yodoo_module_category_search_website">
        <field name="model">yodoo.module.category</field>
        <field name="inherit_id"
               ref="yodoo_apps_database.yodoo_category_module_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <filter name="unpublished"
                        string="Unpublished"
                        domain="[('is_published','=',False)]"/>
                <filter name="unlisted"
                        string="Unlisted"
                        domain="[('is_listed_on_website','=',False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
